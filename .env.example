# Public by design: Supabase's project URL and publishable/anon key are safe in
# the browser only when Row Level Security is enabled on every exposed table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never prefix privileged credentials with NEXT_PUBLIC_. Do not use a Supabase
# service-role key in this application runtime.
APP_TIME_ZONE=America/Barbados

